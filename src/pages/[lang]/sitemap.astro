---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNavBar from '@/components/domains/nav/TopNavBar.astro';
import Footer from '@/components/domains/shared/Footer.astro';
import type { Locale } from '@/i18n/utils';
import { locales, getDictionary } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getDictionary(locale);

const sitemapData = [
  {
    title: t.sitemap.sections.main,
    links: [
      { href: `/${locale}/`, label: t.nav.home },
      { href: `/${locale}${t.nav.links.about}`, label: t.nav.about },
      { href: `/${locale}${t.nav.links.contact}`, label: t.nav.contact },
    ]
  },
  {
    title: t.sitemap.sections.inventory,
    links: [
      { href: `/${locale}${t.nav.links.inventory}`, label: t.nav.inventory },
      { href: `/${locale}${t.nav.links.forRent}`, label: t.nav.forRent },
      { href: `/${locale}${t.nav.links.forSale}`, label: t.nav.forSale },
    ]
  },
  {
    title: t.sitemap.sections.legal,
    links: [
      { href: `/${locale}/legal/privacy/`, label: t.footer.privacy },
      { href: `/${locale}/legal/terms/`, label: t.footer.terms },
      { href: `/${locale}/legal/cookies/`, label: t.footer.cookies },
    ]
  }
];
---

<BaseLayout locale={locale} title={t.sitemap.title}>
  <TopNavBar 
    locale={locale} 
    currentPath={Astro.url.pathname}
    lightLabel={t.theme.toggleLight}
    darkLabel={t.theme.toggleDark}
  />
  
  <main class="pt-32 pb-24 min-h-screen">
    <div class="max-w-7xl mx-auto px-6 md:px-8">
      <!-- Header -->
      <div class="max-w-3xl mb-16 animate-in fade-in slide-in-from-bottom-8 duration-700">
        <h1 class="text-h1 font-display font-black tracking-tight text-on-surface mb-6">
          {t.sitemap.title}
        </h1>
        <p class="text-body-lg text-on-surface-variant leading-relaxed">
          {t.sitemap.subtitle}
        </p>
      </div>

      <!-- Sitemap Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sitemapData.map((section, idx) => (
          <div 
            class="bg-surface-container-low/40 backdrop-blur-sm border border-outline-variant/20 rounded-3xl p-8 animate-in fade-in slide-in-from-bottom-12 duration-1000"
            style={`transition-delay: ${idx * 100}ms`}
          >
            <h2 class="text-label-caps text-primary font-black tracking-widest mb-6">
              {section.title}
            </h2>
            <ul class="space-y-4">
              {section.links.map(link => (
                <li>
                  <a 
                    href={link.href}
                    class="group flex items-center text-body-md text-on-surface-variant hover:text-primary transition-all duration-300"
                  >
                    <span class="w-1.5 h-1.5 rounded-full bg-outline-variant mr-3 group-hover:bg-primary group-hover:scale-125 transition-all"></span>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
