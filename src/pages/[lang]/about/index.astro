---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNavBar from '@/components/domains/nav/TopNavBar.astro';
import Footer from '@/components/domains/shared/Footer.astro';
import { locales, getDictionary } from '@/i18n/utils';
import type { Locale } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getDictionary(locale);

const title = `${t.about.title} | ${t.site.name}`;
const description = t.about.subtitle;

const stats = [
  { value: t.about.stat1Value, label: t.about.stat1Label },
  { value: t.about.stat2Value, label: t.about.stat2Label },
  { value: t.about.stat3Value, label: t.about.stat3Label },
  { value: t.about.stat4Value, label: t.about.stat4Label },
];

const values = [
  { icon: 'verified', title: t.about.value1Title, body: t.about.value1Body },
  { icon: 'visibility', title: t.about.value2Title, body: t.about.value2Body },
  { icon: 'favorite', title: t.about.value3Title, body: t.about.value3Body },
];
---

<BaseLayout locale={locale} title={title} description={description}>
  <TopNavBar
    locale={locale}
    currentPath={Astro.url.pathname}
    lightLabel={t.theme.toggleLight}
    darkLabel={t.theme.toggleDark}
  />

  <main class="pb-0">

    <!-- HERO -->
    <section class="relative pt-40 pb-2xl overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/8 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
      <div class="absolute top-20 right-0 w-[700px] h-[700px] bg-primary/6 rounded-full blur-[160px] pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-secondary/4 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl mx-auto px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2xl items-center">

          <!-- Left: text -->
          <div class="space-y-lg">
            <div class="inline-flex items-center gap-sm px-md py-2 rounded-full bg-primary/10 border border-primary/20">
              <span class="material-symbols-outlined text-primary" style="font-size:14px;font-variation-settings:'FILL' 1">stars</span>
              <span class="text-xs font-black uppercase tracking-[0.12em] text-primary font-display">AeroDrive</span>
            </div>
            <h1 class="text-h1 font-display font-black tracking-tight text-on-surface leading-none">
              {t.about.title}
            </h1>
            <p class="text-body-lg text-on-surface-variant leading-relaxed max-w-lg">
              {t.about.subtitle}
            </p>
            <a
              href={`/${locale}/contact/`}
              class="inline-flex items-center gap-sm rounded-full bg-primary text-on-primary px-xl py-3 text-label-caps uppercase tracking-[0.05em] font-semibold font-body hover:bg-primary-container hover:text-on-primary-container transition-all duration-300 active:scale-95"
            >
              {t.about.commitmentCta}
              <span class="material-symbols-outlined" style="font-size:18px">arrow_forward</span>
            </a>
          </div>

          <!-- Right: decorative card -->
          <div class="relative flex items-center justify-center h-72 lg:h-auto" aria-hidden="true">
            <div class="absolute w-80 h-80 rounded-full bg-primary/10 blur-[70px]"></div>
            <div class="relative w-60 h-60 rounded-[2rem] bg-surface-container-lowest border border-outline-variant/30 shadow-xl flex items-center justify-center rotate-3">
              <span class="material-symbols-outlined text-primary" style="font-size:100px;font-variation-settings:'FILL' 1,'wght' 300">directions_car</span>
            </div>
            <div class="absolute top-6 right-4 lg:right-0 bg-surface-container-lowest rounded-xl px-md py-2 border border-outline-variant/20 shadow-sm flex items-center gap-xs">
              <span class="material-symbols-outlined text-[#4CAF50]" style="font-size:15px;font-variation-settings:'FILL' 1">verified</span>
              <span class="text-xs font-semibold text-on-surface font-body">{t.about.stat3Value}</span>
            </div>
            <div class="absolute bottom-6 left-4 lg:left-0 bg-surface-container-lowest rounded-xl px-md py-2 border border-outline-variant/20 shadow-sm flex items-center gap-xs">
              <span class="material-symbols-outlined text-primary" style="font-size:15px;font-variation-settings:'FILL' 1">star</span>
              <span class="text-xs font-semibold text-on-surface font-body">{t.about.stat4Value}</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS BAR -->
    <section class="border-y border-outline-variant/20 bg-surface-container-lowest">
      <div class="max-w-7xl mx-auto px-8 py-xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-lg">
          {stats.map(({ value, label }) => (
            <div class="text-center space-y-xs">
              <div class="text-h2 font-display font-black text-primary">{value}</div>
              <div class="text-on-surface-variant font-body font-semibold uppercase tracking-wider" style="font-size:11px">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- MISSION -->
    <section class="py-2xl">
      <div class="max-w-7xl mx-auto px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2xl items-center">

          <!-- Decorative quote card -->
          <div class="relative order-2 lg:order-1">
            <div class="relative p-xl bg-surface-container-lowest rounded-3xl border border-outline-variant/20 shadow-sm overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-primary via-primary-container to-transparent"></div>
              <div class="text-primary font-black leading-none mb-sm" style="font-size:72px;line-height:1">"</div>
              <p class="text-h3 font-display font-bold text-on-surface leading-snug">
                {t.about.missionBody}
              </p>
            </div>
          </div>

          <!-- Text -->
          <div class="order-1 lg:order-2 space-y-lg">
            <div class="space-y-sm">
              <span class="text-xs font-black uppercase tracking-[0.12em] text-primary font-display">{t.about.missionTitle}</span>
              <h2 class="text-h2 font-display font-bold text-on-surface">
                {t.about.missionTitle}
              </h2>
            </div>
            <p class="text-body-lg text-on-surface-variant leading-relaxed">
              {t.about.missionBody}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- VALUES -->
    <section class="py-2xl bg-surface-container-lowest/60">
      <div class="max-w-7xl mx-auto px-8">
        <div class="text-center mb-2xl space-y-sm">
          <span class="text-xs font-black uppercase tracking-[0.12em] text-primary font-display">{t.about.valuesTitle}</span>
          <h2 class="text-h2 font-display font-bold text-on-surface">{t.about.valuesTitle}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-lg">
          {values.map(({ icon, title: valueTitle, body }) => (
            <div class="group relative bg-surface-container-lowest rounded-2xl p-xl border border-outline-variant/20 shadow-sm hover:shadow-md hover:border-primary/20 transition-all duration-300 overflow-hidden">
              <div class="absolute top-0 left-0 right-0 h-0.5 bg-gradient-to-r from-primary/0 via-primary/60 to-primary/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
              <div class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center mb-lg group-hover:bg-primary/20 transition-colors duration-300">
                <span class="material-symbols-outlined text-primary" style="font-size:28px;font-variation-settings:'FILL' 1">{icon}</span>
              </div>
              <h3 class="text-h3 font-display font-semibold text-on-surface mb-sm">{valueTitle}</h3>
              <p class="text-body-md text-on-surface-variant leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- COMMITMENT CTA -->
    <section class="relative py-2xl bg-primary overflow-hidden">
      <div class="absolute top-0 right-0 w-96 h-96 bg-white/5 rounded-full blur-[80px] pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/5 rounded-full blur-[60px] pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-4xl mx-auto px-8 text-center relative z-10">
        <h2 class="text-h2 font-display font-black text-on-primary mb-md">
          {t.about.commitmentTitle}
        </h2>
        <p class="text-body-lg text-on-primary/80 mb-xl max-w-2xl mx-auto leading-relaxed">
          {t.about.commitmentBody}
        </p>
        <a
          href={`/${locale}/contact/`}
          class="inline-flex items-center gap-sm rounded-full bg-on-primary text-primary px-xl py-3 text-label-caps uppercase tracking-[0.05em] font-semibold font-body hover:bg-on-primary/90 transition-all duration-300 active:scale-95"
        >
          {t.about.commitmentCta}
          <span class="material-symbols-outlined" style="font-size:18px">arrow_forward</span>
        </a>
      </div>
    </section>

  </main>

  <Footer locale={locale} />
</BaseLayout>
