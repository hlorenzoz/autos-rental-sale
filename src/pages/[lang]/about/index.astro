---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNavBar from '@/components/domains/nav/TopNavBar.astro';
import Footer from '@/components/domains/shared/Footer.astro';
import type { Locale } from '@/i18n/utils';
import { locales, getDictionary } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getDictionary(locale);

const title = `${t.about.title} | ${t.site.name}`;
const description = t.about.subtitle;

const values = [
  {
    icon: 'verified',
    title: t.about.value1Title,
    body: t.about.value1Body,
  },
  {
    icon: 'visibility',
    title: t.about.value2Title,
    body: t.about.value2Body,
  },
  {
    icon: 'favorite',
    title: t.about.value3Title,
    body: t.about.value3Body,
  },
];
---

<BaseLayout locale={locale} title={title} description={description}>
  <TopNavBar
    locale={locale}
    currentPath={Astro.url.pathname}
    lightLabel={t.theme.toggleLight}
    darkLabel={t.theme.toggleDark}
  />

  <main class="pt-24 pb-xl relative overflow-hidden">
    <!-- Background glow -->
    <div class="absolute top-0 right-0 w-[40%] aspect-square bg-primary/5 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>

    <div class="max-w-4xl mx-auto px-8 relative z-10">

      <!-- Hero section -->
      <div class="text-center mb-2xl space-y-md">
        <h1 class="text-h1 font-display font-black tracking-tight text-on-surface">
          {t.about.title}
        </h1>
        <p class="text-body-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
          {t.about.subtitle}
        </p>
      </div>

      <!-- Mission section -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-xl mb-2xl items-center">
        <div class="space-y-md">
          <h2 class="text-h2 font-display font-bold text-on-surface">
            {t.about.missionTitle}
          </h2>
          <p class="text-body-lg text-on-surface-variant leading-relaxed">
            {t.about.missionBody}
          </p>
        </div>
        <!-- Decorative visual -->
        <div class="relative flex items-center justify-center" aria-hidden="true">
          <div class="w-64 h-64 rounded-full bg-primary/10 blur-2xl absolute"></div>
          <div class="relative w-48 h-48 rounded-3xl bg-surface-container-lowest border border-outline-variant/20 shadow-sm flex items-center justify-center">
            <span class="material-symbols-outlined text-7xl text-primary">directions_car</span>
          </div>
        </div>
      </div>

      <!-- Values section -->
      <div>
        <h2 class="text-h2 font-display font-bold text-on-surface mb-xl text-center">
          {t.about.valuesTitle}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-lg">
          {values.map(({ icon, title: valueTitle, body }) => (
            <div class="bg-surface-container-lowest rounded-2xl p-lg border border-outline-variant/20 shadow-sm space-y-sm">
              <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center mb-md">
                <span class="material-symbols-outlined text-2xl text-primary">{icon}</span>
              </div>
              <h3 class="text-h3 font-display font-semibold text-on-surface">
                {valueTitle}
              </h3>
              <p class="text-body-lg text-on-surface-variant leading-relaxed">
                {body}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </main>

  <Footer locale={locale} />
</BaseLayout>
