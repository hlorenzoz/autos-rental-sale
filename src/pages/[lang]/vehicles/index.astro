---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNavBar from '@/components/domains/nav/TopNavBar.astro';
import Footer from '@/components/domains/shared/Footer.astro';
import VehicleGrid from '@/components/domains/vehicles/VehicleGrid.astro';
import SearchPill from '@/components/ui/SearchPill';
import { getAllVehicles } from '@/lib/vehicles';
import type { Locale } from '@/i18n/utils';
import { locales, getDictionary } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getDictionary(locale);
const vehicles = getAllVehicles();

// SEO Metadata
const title = `${t.nav.inventory} | ${t.site.name}`;
const description = t.vehicles.allVehiclesSubline;
---

<BaseLayout locale={locale} title={title} description={description}>
  <TopNavBar 
    locale={locale} 
    currentPath={Astro.url.pathname}
    lightLabel={t.theme.toggleLight}
    darkLabel={t.theme.toggleDark}
  />
  
  <main class="pt-24 pb-xl">
    <!-- Header Zone -->
    <section class="mb-xl">
      <div class="max-w-7xl mx-auto px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-lg border-b border-outline-variant/20 pb-lg">
          <div class="space-y-sm">
            <h1 class="text-h1 font-display font-black tracking-tight text-on-surface">
              {t.vehicles.allVehicles}
            </h1>
            <p class="text-body-lg text-on-surface-variant max-w-2xl">
              {t.vehicles.allVehiclesSubline}
            </p>
          </div>
          
          <div class="w-full md:w-auto">
             <SearchPill 
              client:load
              buyLabel={t.hero.buy}
              rentLabel={t.hero.rent}
              placeholder={t.hero.searchPlaceholder}
              filterLabel={t.hero.filterLabel}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Inventory Grid -->
    <section>
      <div class="max-w-7xl mx-auto px-8">
        <VehicleGrid vehicles={vehicles} locale={locale} columns={3} />
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>
