---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNavBar from '@/components/domains/nav/TopNavBar.astro';
import Footer from '@/components/domains/shared/Footer.astro';
import VehicleHubIsland from '@/components/ui/VehicleHubIsland';
import { getAllVehicles } from '@/lib/vehicles';
import type { Locale } from '@/i18n/utils';
import { locales, getDictionary } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getDictionary(locale);
const vehicles = getAllVehicles();

const title = `${t.nav.inventory} | ${t.site.name}`;
const description = t.vehicles.allVehiclesSubline;
---

<BaseLayout locale={locale} title={title} description={description}>
  <TopNavBar
    locale={locale}
    currentPath={Astro.url.pathname}
    lightLabel={t.theme.toggleLight}
    darkLabel={t.theme.toggleDark}
  />

  <main class="pt-24 pb-xl">
    <!-- Header Zone -->
    <section class="mb-lg">
      <div class="max-w-7xl mx-auto px-8">
        <div class="border-b border-outline-variant/20 pb-lg">
          <div class="space-y-sm">
            <h1 class="text-h1 font-display font-black tracking-tight text-on-surface">
              {t.vehicles.allVehicles}
            </h1>
            <p class="text-body-lg text-on-surface-variant max-w-2xl">
              {t.vehicles.allVehiclesSubline}
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Hub Island -->
    <section>
      <div class="max-w-7xl mx-auto px-8">
        <VehicleHubIsland
          client:load
          vehicles={vehicles}
          locale={locale}
          labels={{
            buyLabel: t.hero.buy,
            rentLabel: t.hero.rent,
            placeholder: t.hero.searchPlaceholder,
            filterLabel: t.hero.filterLabel,
            filters: [
              { label: t.filters.electric, value: 'electric' },
              { label: t.filters.suv, value: 'suv' },
              { label: t.filters.luxury, value: 'luxury' },
              { label: t.filters.budget, value: 'budget' },
            ],
            noResults: t.filters.noResults,
            clearFilters: t.filters.clearFilters,
            found: t.filters.searchLabel,
            bookNow: t.vehicles.bookNow,
            inquire: t.vehicles.inquire,
          }}
          vehiclesSlug={t.nav.slugs.vehicles}
        />
      </div>
    </section>
  </main>

  <Footer locale={locale} />
</BaseLayout>
