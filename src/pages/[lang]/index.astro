---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopNavBar from '@/components/domains/nav/TopNavBar.astro';
import HeroSection from '@/components/domains/shared/HeroSection.astro';
import OverviewSection from '@/components/domains/landing/OverviewSection.astro';
import FeaturedVehicles from '@/components/domains/vehicles/FeaturedVehicles.astro';
import ServicesSection from '@/components/domains/landing/ServicesSection.astro';
import ReviewsSection from '@/components/domains/landing/ReviewsSection.astro';
import ContactSection from '@/components/domains/landing/ContactSection.astro';
import Footer from '@/components/domains/shared/Footer.astro';
import type { Locale } from '@/i18n/utils';
import { locales } from '@/i18n/utils';
import { getDictionary } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = lang as Locale;
const t = getDictionary(locale);
---

<BaseLayout locale={locale}>
  <TopNavBar 
    locale={locale} 
    currentPath={Astro.url.pathname}
    lightLabel={t.theme.toggleLight}
    darkLabel={t.theme.toggleDark}
  />
  
  <main>
    <HeroSection locale={locale} />
    <OverviewSection locale={locale} />
    <FeaturedVehicles locale={locale} />
    <ServicesSection locale={locale} />
    <ReviewsSection locale={locale} />
    <ContactSection locale={locale} />
  </main>

  <Footer locale={locale} />
</BaseLayout>
