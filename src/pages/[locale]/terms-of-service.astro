---
import LegalLayout from '@/layouts/LegalLayout.astro';
import LegalSection from '@/components/ui/LegalSection.astro';
import { locales, getDictionary } from '@/i18n/utils';
import type { Locale } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getDictionary(locale);
const legal = t.legal;
---

<LegalLayout 
  locale={locale} 
  title={legal.termsTitle} 
  lastUpdated={legal.termsLastUpdated}
>
  <div class="bg-surface-container-lowest p-8 lg:p-12 rounded-xl border border-outline-variant shadow-[0_20px_40px_rgba(0,67,200,0.05)]">
    <div class="space-y-12">
      {legal.terms.sections.map((section, index) => (
        <section id={`section-${index + 1}`}>
          <div class="flex items-baseline gap-4 mb-6 border-b border-surface-container pb-2">
            <span class="text-h2 font-display text-primary">{(index + 1).toString().padStart(2, '0')}.</span>
            <h2 class="text-h2 font-display font-bold text-on-surface">
              {section.title}
            </h2>
          </div>
          
          <div class="text-body-md text-on-surface-variant leading-relaxed space-y-4">
            <p>{section.content}</p>
            
            {/* Special handling for User Responsibilities / Prohibited Activities style */}
            {section.title.includes('Responsibilities') || section.title.includes('Responsabilidades') ? (
              <div class="bg-surface-container-low p-6 rounded-lg mt-6 border border-surface-container-high">
                <h3 class="text-h3 font-display font-bold text-on-surface mb-3">
                  {locale === 'en' ? 'Prohibited Activities' : 'Actividades Prohibidas'}
                </h3>
                <ul class="list-disc pl-6 space-y-2 text-sm">
                  {locale === 'en' ? (
                    <>
                      <li>Competitive driving or racing.</li>
                      <li>Towing or pushing objects.</li>
                      <li>Transporting hazardous materials.</li>
                      <li>Driving under the influence.</li>
                    </>
                  ) : (
                    <>
                      <li>Conducción competitiva o carreras.</li>
                      <li>Remolcar o empujar objetos.</li>
                      <li>Transporte de materiales peligrosos.</li>
                      <li>Conducir bajo la influencia de sustancias.</li>
                    </>
                  )}
                </ul>
              </div>
            ) : null}
          </div>
        </section>
      ))}
    </div>
  </div>
</LegalLayout>
