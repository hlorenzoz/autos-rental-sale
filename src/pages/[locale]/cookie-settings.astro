---
import LegalLayout from '@/layouts/LegalLayout.astro';
import CookieManager from '@/components/domains/legal/CookieManager';
import { locales, getDictionary } from '@/i18n/utils';
import type { Locale } from '@/i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getDictionary(locale);
const legal = t.legal;
---

<LegalLayout 
  locale={locale} 
  title={legal.cookiesTitle} 
  lastUpdated={legal.cookiesLastUpdated}
>
  <div class="bg-surface-container-lowest border border-outline-variant rounded-lg p-6 lg:p-8 atmospheric-shadow">
    <CookieManager client:load dictionary={legal.cookies} />
  </div>
</LegalLayout>
