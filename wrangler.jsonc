{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autos-rental",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "autos-rental.hlorenzoz.com",
      "custom_domain": true
    }
  ],
  "env": {
    "staging": {
      "routes": [
        {
          "pattern": "staging.autos-rental.hlorenzoz.com",
          "custom_domain": true
        }
      ]
    }
  }
}




