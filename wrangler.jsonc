{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autos-rental-sale",
  "compatibility_date": "2026-05-02",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "00000000000000000000000000000000"
    }
  ]
}
